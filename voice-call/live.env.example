# chmod 600. Never commit the real file.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Puck
INPUT_LANGUAGES=he-IL
OWNER_NUMBER=972501234567
OWNER_NAME=
# optional tuning
# END_SILENCE_MS=300      # silence before he answers
# ASK_LIMIT_MS=7000       # how long the voice waits for Hermes before continuing in the background
# ASK_MAX_MS=90000       # longest a non-blocking Hermes lookup may take
# ASYNC_TOOLS=0           # set to 0 to make lookups blocking again
# MAX_CALL_MIN=30         # hard call length cap
# SILENCE_HANGUP_S=150    # hang up after this much silence
# BOT_NUMBER=              # the number the daemon is linked to (digits, with country code): errand calls to it are refused
# ERRAND_CODE=off          # errand calls: 'off' = the owner's yes in chat is the approval; leave unset to require a one-time code sent to the owner's chat
# ERRAND_PER_HOUR=4        # errand calls per hour
# ERRAND_MAX_MIN=6         # errand call length cap
